{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "identifier": "default",
  "description": "Permisos por defecto para el visor OIM",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-file"
  ]
}
