# Defense against supply-chain worms (Shai-Hulud and similar):
# blocks postinstall/preinstall scripts of dependencies, which are the
# infection vector. pnpm >=10 ignores them by default, but this makes it
# explicit and also covers any accidental invocation of npm.
# If a future dependency needs to build native binaries on install
# (e.g. sharp), allow it with `pnpm approve-builds` instead of removing
# this line.
ignore-scripts=true

# Do not install versions published less than 24 hours ago: waves of
# compromised packages are usually detected and unpublished within hours.
minimum-release-age=1440

