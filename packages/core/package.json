{
  "name": "@oim-media/core",
  "version": "1.27.9",
  "description": "Core of the OIM format: the contract schema, binary extraction from PNG and the shared rendering logic used by every OIM player.",
  "keywords": [
    "oim",
    "interactive-image",
    "png",
    "schema",
    "zod"
  ],
  "author": "Xue Studios LLC",
  "homepage": "https://oim.media",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./generative": {
      "types": "./dist/generative/index.d.ts",
      "default": "./dist/generative/index.js"
    },
    "./generative/catalog": {
      "types": "./dist/generative/catalog.d.ts",
      "default": "./dist/generative/catalog.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "ajv": "^8.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oim-media/oim.git",
    "directory": "packages/core"
  }
}
