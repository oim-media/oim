# Defensa contra gusanos de cadena de suministro (Shai-Hulud y similares):
# bloquea los scripts postinstall/preinstall de las dependencias, que son
# el mecanismo de infección. pnpm >=10 ya los ignora por defecto, pero
# esto lo hace explicito y cubre tambien cualquier uso accidental de npm.
# Si una dependencia futura necesita compilar binarios en la instalacion
# (p. ej. sharp), autorizala con `pnpm approve-builds` en lugar de quitar
# esta linea.
ignore-scripts=true

# No instalar versiones publicadas hace menos de 24h: las oleadas de
# paquetes infectados suelen detectarse y despublicarse en horas.
minimum-release-age=1440

