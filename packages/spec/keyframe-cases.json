[
  { "name": "linear translate", "duration": 2,
    "keyframes": [{ "t": 0, "x": 0 }, { "t": 2, "x": 100 }],
    "samples": [{ "time": 0, "expect": { "x": 0, "y": 0, "r": 0, "s": 1, "o": 1, "b": 0 } }, { "time": 1, "expect": { "x": 50 } }, { "time": 2, "expect": { "x": 100 } }] },
  { "name": "ease-in on the left frame", "duration": 1,
    "keyframes": [{ "t": 0, "x": 0, "e": "ease-in" }, { "t": 1, "x": 100 }],
    "samples": [{ "time": 0.5, "expect": { "x": 31.5357 } }] },
  { "name": "bezier tuple equals ease-in-out", "duration": 1,
    "keyframes": [{ "t": 0, "r": 0, "e": [0.42, 0, 0.58, 1] }, { "t": 1, "r": 360 }],
    "samples": [{ "time": 0.25, "expect": { "r": 46.4983 } }, { "time": 0.5, "expect": { "r": 180 } }] },
  { "name": "steps(1, end) holds the left value", "duration": 1,
    "keyframes": [{ "t": 0, "s": 1, "e": "steps(1, end)" }, { "t": 1, "s": 2 }],
    "samples": [{ "time": 0.99, "expect": { "s": 1 } }, { "time": 1, "expect": { "s": 2 } }] },
  { "name": "first frame after 0 starts from the base", "duration": 4,
    "keyframes": [{ "t": 2, "y": 40 }, { "t": 4, "y": 80 }],
    "samples": [{ "time": 1, "expect": { "y": 20 } }, { "time": 3, "expect": { "y": 60 } }] },
  { "name": "last frame before the end holds to the base", "duration": 4,
    "keyframes": [{ "t": 0, "x": 10 }, { "t": 2, "x": 30 }],
    "samples": [{ "time": 3, "expect": { "x": 15 } }] },
  { "name": "opacity only in some frames", "duration": 2,
    "keyframes": [{ "t": 0, "x": 0 }, { "t": 1, "x": 10, "o": 0 }, { "t": 2, "x": 20 }],
    "samples": [{ "time": 0.5, "expect": { "o": 0.5, "x": 5 } }, { "time": 1.5, "expect": { "o": 0.5 } }] },
  { "name": "opacity above 1 is returned unclamped", "duration": 1,
    "keyframes": [{ "t": 0, "o": 1.5 }, { "t": 1, "o": 0.5 }],
    "samples": [{ "time": 0, "expect": { "o": 1.5 } }, { "time": 0.5, "expect": { "o": 1 } }] },
  { "name": "blur interpolates from none", "duration": 1,
    "keyframes": [{ "t": 0 }, { "t": 1, "b": 8 }],
    "samples": [{ "time": 0.5, "expect": { "b": 4 } }] },
  { "name": "time past the duration clamps", "duration": 1,
    "keyframes": [{ "t": 0, "x": 0 }, { "t": 1, "x": 5 }],
    "samples": [{ "time": 7, "expect": { "x": 5 } }] }
]
